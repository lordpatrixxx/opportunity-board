# ==============================================================================
# Opportunity Board Environment Configuration (Example Template)
# Copy this file to .env or configure in your deployment hosting provider.
# Do NOT commit actual secrets to version control.
# ==============================================================================

# Database connection URL (SQLite for local/serverless default or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Secret key used for signing JWT authentication tokens
JWT_SECRET="your_secure_random_jwt_secret_minimum_32_characters_long"

# Application metadata and base URLs
NEXT_PUBLIC_APP_NAME="Opportunity Board"
NEXT_PUBLIC_APP_URL="https://your-deployment-url.vercel.app"
